{
    "version": 2,
    "builds": [
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        },
        {
            "src": "backend/app.py",
            "use": "@vercel/python"
        }
    ],
    "rewrites": [
        {
            "source": "/(api|registrations|download-excel|clear-data|payment-settings|upload-qr|uploads)/(.*)",
            "destination": "backend/app.py"
        },
        {
            "source": "/index.html",
            "destination": "/index.html"
        },
        {
            "source": "/assets/(.*)",
            "destination": "/assets/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}